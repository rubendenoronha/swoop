<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: AppleScript to System Events / Finder / Terminal (dark mode,
       empty Trash, restart, login items, brew upgrade) needs this. Not sandboxed:
       a cleaner and launcher can't work inside the App Sandbox. -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
