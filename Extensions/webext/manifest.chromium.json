{
  "manifest_version": 3,
  "name": "Swoop Shield",
  "short_name": "Swoop Shield",
  "version": "0.2.0",
  "description": "Blocks ads, trackers and malware on web pages, including in-page ads that DNS blocking can't remove. Part of Swoop for Mac. No telemetry.",
  "homepage_url": "https://swoopkey.com",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["declarativeNetRequest", "storage", "scripting", "webNavigation", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Swoop Shield" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true },
    { "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://*.youtubekids.com/*"], "js": ["youtube.js"], "run_at": "document_start", "all_frames": false }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "swoop_builtin", "enabled": true, "path": "rules/swoop_builtin.json" }]
  },
  "web_accessible_resources": []
}
