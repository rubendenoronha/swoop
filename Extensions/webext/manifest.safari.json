{
  "manifest_version": 3,
  "name": "Swoop Shield Page Cleaner",
  "version": "0.2.4",
  "description": "Hides in-page ads and runs Swoop Shield's scriptlets. Network blocking in Safari is done by the Swoop Shield content blockers.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "scripting", "webNavigation", "activeTab", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["scriptlets.js", "background.js"], "persistent": false },
  "action": { "default_popup": "popup.html", "default_title": "Swoop Shield" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://*.youtubekids.com/*"], "js": ["youtube.js"], "run_at": "document_start" }
  ]
}
